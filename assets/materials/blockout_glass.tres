[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; The arena blockout's window panes and the keep's arrow slits.
;
; Assigned PER SURFACE by scripts/painted_skin.gd, to the surfaces named `bo_glass` — never as a
; node's material_override. That is the rule that keeps shaders/glass_stylized.gdshader's fresnel
; scoped to glass, which is the whole basis on which painted_env.gdshader's standing "no rim"
; decision survives having an exception at all.
;
; The tint is dark and cold on purpose: there is nothing behind these windows but wall, so the pane
; is standing in for a room it does not have. A dark interior plus a bright edge is the read; a pale
; pane would just look like a missing texture.
;
; emission_boost stays at 0 here. Glow's hdr_threshold is 1.1 and a daylit pane's rim already sits
; near it — the setting is for lantern panes, which are their own light source.

[ext_resource type="Shader" path="res://shaders/glass_stylized.gdshader" id="1_glass"]

[resource]
shader = ExtResource("1_glass")
shader_parameter/glass_color = Color(0.055, 0.085, 0.105, 1)
shader_parameter/glass_alpha = 0.82
shader_parameter/sky_color = Color(0.25, 0.5, 0.85, 1)
shader_parameter/horizon_color = Color(0.7, 0.83, 0.95, 1)
shader_parameter/ground_color = Color(0.5, 0.58, 0.52, 1)
shader_parameter/reflection_strength = 0.45
shader_parameter/horizon_sharpness = 2.0
shader_parameter/fresnel_power = 3.2
shader_parameter/fresnel_strength = 0.85
shader_parameter/fresnel_color = Color(1, 0.94, 0.82, 1)
shader_parameter/distort_scale = 4.0
shader_parameter/distort_amount = 0.06
shader_parameter/emission_boost = 0.0
shader_parameter/matcap_strength = 0.0
