[gd_resource type="StandardMaterial3D" load_steps=5 format=3]

; THE TOON COPY of dungeon_floor.tres (tools/make_dungeon.gd -- --variant=toon): the same normal map, AO and
; deep parallax, the albedo flattened toward paint (assets/textures/dungeon_toon/), the tint saturated at the
; same luminance, and Godot's own cel path — diffuse TOON (docs: "a hard cut for lighting, with smoothing
; affected by roughness": smoothstep(-r, r, NdotL), so the SCALAR roughness 0.3 IS the band edge and the ARM's
; roughness is dropped), specular DISABLED (a toon blob on stone reads as plastic), an albedo-tinted rim.
[ext_resource type="Texture2D" path="res://assets/textures/dungeon_toon/stone_tiles_02_Diffuse.jpg" id="1_diff"]
[ext_resource type="Texture2D" path="res://assets/textures/dungeon/stone_tiles_02_nor_gl.jpg" id="2_nrm"]
[ext_resource type="Texture2D" path="res://assets/textures/dungeon/stone_tiles_02_arm.jpg" id="3_arm"]
[ext_resource type="Texture2D" path="res://assets/textures/dungeon/stone_tiles_02_Displacement.jpg" id="4_disp"]

[resource]
resource_name = "DungeonToonFloor"
albedo_color = Color(0.45, 0.4, 0.35, 1)
albedo_texture = ExtResource("1_diff")
metallic = 0.0
roughness = 0.3
normal_enabled = true
normal_scale = 0.7
normal_texture = ExtResource("2_nrm")
ao_enabled = true
ao_light_affect = 0.5
ao_texture = ExtResource("3_arm")
ao_texture_channel = 0
uv1_scale = Vector3(0.5, 0.5, 1)
texture_filter = 5
heightmap_enabled = true
heightmap_scale = 5.0
heightmap_deep_parallax = true
heightmap_min_layers = 8
heightmap_max_layers = 24
heightmap_texture = ExtResource("4_disp")
diffuse_mode = 3
specular_mode = 2
rim_enabled = true
rim = 0.25
rim_tint = 0.8
