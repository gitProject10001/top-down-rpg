; A RENDERED WALL — ambientCG Ground057, used as lime render rather than as ground.
;
; UVs come in METRES already (GladeFillPanel lays them as metres / style.panel_uv_scale), so this
; keeps uv1_scale at 1 and lets the STYLE decide how big a tile is. Tiling a wall is a fact about the
; wall, not about the material, and two buildings sharing one render want it at different sizes.
;
; NormalGL, not NormalDX: Godot reads the green channel the OpenGL way, and the DX map inverts every
; bump into a dent — which reads as "the light is wrong" rather than as an obvious mistake.
[gd_resource type="StandardMaterial3D" load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://assets/textures/glade/plaster_render_color.png" id="1_col"]
[ext_resource type="Texture2D" path="res://assets/textures/glade/plaster_render_normal.png" id="2_nrm"]
[ext_resource type="Texture2D" path="res://assets/textures/glade/plaster_render_rough.png" id="3_rgh"]

[resource]
; TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC. The default is the non-anisotropic one, and
; on a surface you look ALONG — a coping, a floor — it picks a mip four levels too coarse and
; hands you grey soup. It reads as "the texture is missing here", which is how it was found.
texture_filter = 5
resource_name = "GladePlasterRender"
albedo_color = Color(1, 0.98, 0.94, 1)
albedo_texture = ExtResource("1_col")
roughness_texture = ExtResource("3_rgh")
roughness_texture_channel = 4
normal_enabled = true
normal_scale = 1.0
normal_texture = ExtResource("2_nrm")
uv1_scale = Vector3(0.8, 0.8, 0.8)
