[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; Bushes: knee-high, quick, light.
;
; The third of the foliage materials, and it exists for exactly the reason the first two do -- the
; comment in painted_foliage_large.tres says wind_height must match the plant's actual height for
; wind_strength to stay in metres, and that a grass tuft and a tree cannot share one value. A bush
; and a tree cannot either, and the arithmetic is not close:
;
;   painted_env's falloff is h = VERTEX.y / wind_height, then h*h. Run a 0.78 m bush through
;   painted_foliage_large's wind_height of 3.2 and the canopy tops out at h = 0.24, h*h = 0.06,
;   so 0.22 m of authored sway becomes 1.3 CM of actual movement. That is not slow wind, it is
;   no wind, and it would read as the bushes being broken rather than as them being sheltered.
;
; wind_speed sits between the two: 2.1 for grass, 1.1 for a tree, 1.7 here. Mass sets the tempo and
; a bush has more of it than a blade and less than a canopy.
;
; SCALE MULTIPLIES SWAY, and that is wanted. BushPatch scatters instances between 0.9x and 2.1x, and
; painted_env does `VERTEX.xz +=` in OBJECT space, so a double-size bush moves double the distance.
; Big bushes catching more wind than small ones is the behaviour you would have had to fake.

[ext_resource type="Shader" path="res://shaders/painted_env.gdshader" id="1_painted"]

[resource]
shader = ExtResource("1_painted")
shader_parameter/albedo_color = Color(1, 1, 1, 1)
; The veg_*.glb foliage is textureless and carries its colour in COLOR_0, unlike the blockout.
shader_parameter/use_vertex_color = true
shader_parameter/wrap = 0.55
shader_parameter/bands = 0.0
shader_parameter/band_softness = 0.35
shader_parameter/shade_tint = Color(0.58, 0.46, 0.6, 1)
shader_parameter/shade_strength = 0.62
shader_parameter/shade_saturation = 1.3
shader_parameter/shade_occlusion = 1.0
shader_parameter/light_tint = Color(1, 0.94, 0.82, 1)
shader_parameter/light_tint_amount = 0.35
shader_parameter/wind_strength = 0.05
; veg_bush_b is the tallest of the three at 0.92 m; sizing to the tallest keeps the shorter two
; slightly under-driven rather than whipping them.
shader_parameter/wind_height = 0.9
shader_parameter/wind_speed = 1.7
shader_parameter/wind_direction = Vector2(1, 0.35)
shader_parameter/wind_wavelength = 0.11
