; The painted surface for everything GladeKit grows — bricks, timbers, plaster, shingles, floors.
;
; SEPARATE from painted_env.tres on purpose. That one dresses house.glb and the ground plane in the
; original lookdev; this one is tuned against docs/images/references/whinbek-conceptart.jpg, and the
; two want different shadow tints. Sharing one resource meant every building tweak moved the ground.
;
; use_vertex_color is LOAD-BEARING here and must stay on: a GladeWall packs its per-brick colour
; into the MultiMesh's per-instance colour, which arrives in the shader on COLOR — the same channel
; a mesh's COLOR_0 uses. Turn it off and every stone in the village goes flat white, taking the
; palette, the course gradient, the weathering and the per-piece jitter with it.
;
; Wired in from GladeStyle.material on alsace_stone.tres and alsace_timber.tres. That is the only
; hook that survives: a GladeWall frees and regrows all of its children on every rebuild, so a
; material_override applied from outside is gone the next time anything nudges the wall.

[gd_resource type="ShaderMaterial" format=3]

[ext_resource type="Shader" path="res://shaders/painted_env.gdshader" id="1_painted"]

[resource]
render_priority = 0
shader = ExtResource("1_painted")
shader_parameter/albedo_color = Color(1, 1, 1, 1)
shader_parameter/use_vertex_color = true
shader_parameter/albedo_texture = null
; Soft terminator. This is the uniform that stops a downward-facing shingle going black: light is
; REMAPPED past N·L = 0 rather than clamped at it, so the underside of an eave keeps a value.
;
; Lowered from 0.50 to 0.38. At 0.50 nothing in the frame could reach the reference's dark end —
; measured, the render's darkest fifth sat at 0.26 luminance against the plate's 0.11, and a wrap
; that high is most of the reason. It was set before SSAO ran at full strength; AO and ambient now
; carry the job of keeping an eave underside off black, which is what wrap was raised for. Do not
; take it much lower without re-shooting docs/images/scene/eave_after.png.
shader_parameter/wrap = 0.38
shader_parameter/bands = 0.0
shader_parameter/band_softness = 0.35
; The reference's shadows are blue-violet everywhere and MORE saturated than its lit surfaces, not
; less. This is the whole difference between "in shade" and "unlit".
shader_parameter/shade_tint = Color(0.42, 0.44, 0.62, 1)
shader_parameter/shade_strength = 0.42
shader_parameter/shade_saturation = 1.2
shader_parameter/shade_occlusion = 1.0
; THE LIT SIDE HAS TO KEEP ITS COLOUR. Measured against the plate, the render's lit quarter came out
; at 0.13 saturation where the painting's is 0.26 — its lights had drifted halfway to white. Mixing
; 40% toward a near-white cream is what did it, so the mix is lighter and the tint itself is a
; proper gold: it now pushes the lit hue toward the plate's 0.116 instead of washing it out.
shader_parameter/light_tint = Color(1, 0.93, 0.78, 1)
shader_parameter/light_tint_amount = 0.3
; Buildings do not sway. Wind belongs to the foliage materials.
shader_parameter/wind_strength = 0.0
shader_parameter/wind_height = 1.0
shader_parameter/wind_speed = 1.6
shader_parameter/wind_direction = Vector2(1, 0.35)
shader_parameter/wind_wavelength = 0.11
