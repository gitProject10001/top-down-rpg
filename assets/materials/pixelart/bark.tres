[gd_resource type="ShaderMaterial" load_steps=4 format=3]

; TRUNKS -- the CampBark slot. Drawn plates rather than a photograph, on pixel_drawn like the rest
; of the architecture, with a block that is TALL AND NARROW (0.14 wide, 0.55 high). That aspect is
; the whole difference between bark and brickwork: run the courses the other way and an oak looks
; like a chimney.
;
; row_jitter is at maximum and width_jitter high, because bark has no coursing at all -- the plates
; should never line up into anything a viewer can read as a row.

[ext_resource type="Shader" path="res://shaders/pixelart/pixel_drawn.gdshader" id="1_shader"]
[ext_resource type="Texture2D" path="res://assets/textures/whinbek/boards_color.png" id="2_col"]
[ext_resource type="Material" path="res://assets/materials/pixelart/outline_prop.tres" id="90_outline"]

