[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; THE STANDING FIGURES. Painted by body zone, not textured -- see shaders/pixelart/pixel_char.gdshader
; for why the baked texture page on char_a.glb had to be abandoned. Short version: a thirty-pixel
; figure averages its whole texture down to mush, and mush on a mud ramp standing on mud is invisible.
;
; The surcoat colour is chosen per figure by hashing the instance position, so six copies of one mesh
; arrive as six distinguishable people. Red and blue are deliberately far from anything else in the
; camp: they are the only saturated colours in a frame of browns, which is exactly the job the
; reference gives them.

[ext_resource type="Shader" path="res://shaders/pixelart/pixel_char.gdshader" id="1_shader"]
[ext_resource type="Material" path="res://assets/materials/pixelart/outline_char.tres" id="90_outline"]

