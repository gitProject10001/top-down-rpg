[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; THE HEAVY LINE, for the chapel and the ruin. A building is the largest silhouette in the frame
; and carries the boldest contour -- the same relationship the reference uses, where a house is
; outlined more strongly than the barrel standing against it.

[ext_resource type="Shader" path="res://shaders/pixelart/pixel_outline.gdshader" id="1_shader"]

[resource]
shader = ExtResource("1_shader")
shader_parameter/outline_width = 0.045
shader_parameter/outline_color = Color(0.05, 0.042, 0.036, 1)
shader_parameter/use_baked_normal = true
