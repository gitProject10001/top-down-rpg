[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; THE FIGURE LINE, and the reason this whole per-model system exists.
;
; A thirty-pixel soldier under the global screen-space outline came out solid black: that pass inks
; normal discontinuities, and a dense organic mesh is nothing but normal discontinuities. Turning it
; down far enough to save the figure erased the buildings. A hull draws only the SILHOUETTE, so the
; figure gets a clean contour and keeps its face.
;
; use_baked_normal is FALSE here. char_a.glb is not a propkit build and has no baked UV2; it is an
; organic mesh whose shading normals are already smooth, so the hull closes without help.

[ext_resource type="Shader" path="res://shaders/pixelart/pixel_outline.gdshader" id="1_shader"]

[resource]
shader = ExtResource("1_shader")
shader_parameter/outline_width = 0.012
shader_parameter/outline_color = Color(0.05, 0.042, 0.036, 1)
shader_parameter/use_baked_normal = false
