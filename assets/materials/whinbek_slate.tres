; The main roofs: blue-grey slate with ochre lichen, freestylized wooden_roof_tiles_09.
; Deepest parallax in the set, because a roof is the one surface always seen at a grazing
; angle and a flat one reads as a painted lid.
;
; ONE REPEAT PER 1.1 METRES — and getting this wrong is what makes a PBR set look flat, long
; before parallax is even asked about. The first pass tiled this every five and a half metres:
; a timber bay the size of a house, cobbles a metre across, and texels stretched so far that
; there was no detail left for the relief to bite on.
;
; UVs ARRIVE IN METRES already — `GladeFillPanel` lays them as metres / `style.panel_uv_scale`, which
; is 2 m per tile — so `uv1_scale` here is the real-world size of one repeat, and nothing else.
;
; NormalGL, never NormalDX: Godot reads the green channel the OpenGL way, and the DX map turns every
; bump into a dent. It does not look like an error, it looks like the light is in the wrong place.
[gd_resource type="StandardMaterial3D" load_steps=6 format=3]

[ext_resource type="Texture2D" path="res://assets/textures/whinbek/slate_color.png" id="1_col"]
[ext_resource type="Texture2D" path="res://assets/textures/whinbek/slate_normal.png" id="2_nrm"]
[ext_resource type="Texture2D" path="res://assets/textures/whinbek/slate_rough.png" id="3_rgh"]
[ext_resource type="Texture2D" path="res://assets/textures/whinbek/slate_height.png" id="4_hgt"]
[ext_resource type="Texture2D" path="res://assets/textures/whinbek/slate_ao.png" id="5_ao"]

[resource]
; TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC. The default is the non-anisotropic one, and
; on a surface you look ALONG — a coping, a floor — it picks a mip four levels too coarse and
; hands you grey soup. It reads as "the texture is missing here", which is how it was found.
texture_filter = 5
resource_name = "WhinbekSlate"
albedo_color = Color(0.92, 0.94, 1, 1)
albedo_texture = ExtResource("1_col")
roughness_texture = ExtResource("3_rgh")
roughness_texture_channel = 4
normal_enabled = true
normal_scale = 1.0
normal_texture = ExtResource("2_nrm")
ao_enabled = true
ao_texture = ExtResource("5_ao")
ao_texture_channel = 0
ao_light_affect = 0.35
heightmap_enabled = true
heightmap_scale = 6.0
heightmap_texture = ExtResource("4_hgt")
heightmap_deep_parallax = true
heightmap_min_layers = 16
heightmap_max_layers = 64
uv1_scale = Vector3(1.818, 1.818, 1.818)
