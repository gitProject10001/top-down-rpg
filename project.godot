; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Top-Down RPG"
run/main_scene="res://scenes/dev/hearth_village_playable.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/event_bus.gd"
Fx="*res://scripts/fx.gd"
Traits="*res://scripts/traits/traits.gd"
Dialogue="*res://scripts/dialogue.gd"
Hud="*res://scripts/hud.gd"
Dbg="*res://scripts/debug_view.gd"
CombatFeedback="*res://scripts/combat_feedback.gd"
Notice="*res://scripts/traits/notice.gd"
Sheet="*res://scripts/traits/sheet.gd"
Run="*res://scripts/traits/run_manager.gd"
Water="*res://scripts/water.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/GPUTrail/plugin.cfg")

