; The propagating surface attack — see scripts/ground_wave.gd. The script duplicates both the
; mesh (it animates the radii) and the material (it fades the front), so these are templates.
[node name="GroundWave" type="Node3D"]
script = ExtResource("1_wave")

; mesh BEFORE the surface override: .tscn properties apply in file order, and an override
; assigned to a still-meshless MeshInstance3D is silently dropped (surface 0 does not exist yet).
[node name="Ring" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.07, 0)
mesh = SubResource("wave_ring")
surface_material_override/0 = SubResource("wave_mat")
