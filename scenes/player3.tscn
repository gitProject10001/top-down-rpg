[node name="StateMachine" type="Node" parent="."]
script = ExtResource("2_fsm")
initial_state = NodePath("Idle")

[node name="Idle" type="Node" parent="StateMachine"]
script = ExtResource("3_idle")

[node name="Move" type="Node" parent="StateMachine"]
script = ExtResource("4_move")

; The combo is Quaternius' three-swing sword chain (Sword_Regular_A / _B / _C), not the Mixamo
; atk_h/atk_b/atk_d the other two run. Same state, different clips — see attack.gd's `chain`.
;
; opener_clip is the lunge (Sword_Dash), used ONLY when the first swing has ground to cover. This
; is the same clip the DashAttack state plays, and deliberately so: closing distance should look
; the same whether you asked for it (dash+attack) or the combo did it for you. Inside 0.3 m of
; contact the chain opens on atk_a as normal — a lunge from arm's length would be absurd.
[node name="Attack" type="Node" parent="StateMachine"]
script = ExtResource("5_attack")
chain = PackedStringArray("atk_a", "atk_b", "atk_c")
opener_clip = "atk_dash"

[node name="Dash" type="Node" parent="StateMachine"]
script = ExtResource("6_dash")

[node name="Jump" type="Node" parent="StateMachine"]
script = ExtResource("30_jump")

; THE DIRECTIONAL GUARD, which replaces Block on this body rather than sitting beside it. It is a
; strict superset: a hit that carries a swing direction is answered only by a matching guard, and
; a hit that carries none (a bolt, a mace, anything still running enemy.gd) falls through to
; exactly the omni-guard behaviour Block had — including the robot fight's colour contract, where
; orange bolts are parried back and purple ones ignore the guard entirely. Same "block" clip
; underneath; the four directions are rotated out of it by a skeleton modifier (guard_pose.gd).
[node name="Guard" type="Node" parent="StateMachine"]
script = ExtResource("32_guard")

; THE HELD DIRECTIONAL SWING. Coexists with Attack above rather than replacing it: the click
; combo is still what a body without a direction to give should do, and dash_attack.gd's lunge
; still chains out of it. Which one a press reaches is decided in idle.gd/move.gd — a body
; carrying DirAttack takes this path.
;
; The four clips were already in player3_anims.tres and unused: an overhead chop, a thrust, and
; the two side swings. Their beats are in attack_timing at the top of this file, like every other
; swing on this body.
[node name="DirAttack" type="Node" parent="StateMachine"]
script = ExtResource("33_diratk")

; THE LUNGE. Reached two ways, both without a new binding: hold attack and press dash, or press
; attack in the first half of a dash already under way.
[node name="DashAttack" type="Node" parent="StateMachine"]
script = ExtResource("12_dashatk")

[node name="Hurt" type="Node" parent="StateMachine"]
script = ExtResource("7_hurt")

