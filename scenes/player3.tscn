[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.3125
height = 1.9481

; THE MOVE BLEND IS 1D HERE, not the BlendSpace2D the other two use.
;
; player/player2 run the Mixamo sword-and-shield set, which has a backpedal and both strafes, so
; their Move is a 2D blend in the FACING frame and the body can aim one way while running another.
; Quaternius' library has neither — every locomotion clip faces its direction of travel. So this
; body turns to where it MOVES (Player.face_movement) and the only thing left to blend is SPEED.
;
; The four points are normalized against move_speed, which is what player.gd writes into
; blend_position: 0 = the standing pose, then walk, jog and sprint. They are NOT evenly spaced —
; walk sits low so a light touch of the stick reads as a walk rather than a slow jog.
[sub_resource type="AnimationNodeAnimation" id="an_stand"]
animation = &"idle_sword"

[sub_resource type="AnimationNodeAnimation" id="an_walk"]
animation = &"walk"

[sub_resource type="AnimationNodeAnimation" id="an_jog"]
animation = &"jog"

[sub_resource type="AnimationNodeAnimation" id="an_sprint"]
animation = &"sprint"

[sub_resource type="AnimationNodeBlendSpace1D" id="bs_move"]
blend_point_0/node = SubResource("an_stand")
blend_point_0/pos = 0.0
blend_point_1/node = SubResource("an_walk")
blend_point_1/pos = 0.28
blend_point_2/node = SubResource("an_jog")
blend_point_2/pos = 0.62
blend_point_3/node = SubResource("an_sprint")
blend_point_3/pos = 1.0

[sub_resource type="AnimationNodeAnimation" id="an_idle"]
animation = &"idle_sword"

; One shared swing node whose clip is SWAPPED per attack — play_attack() rewrites `animation` and
; restarts it. That is why the combo, and the lunge, need no states of their own here.
[sub_resource type="AnimationNodeAnimation" id="an_slash"]
animation = &"atk_a"

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_idle_move"]
xfade_time = 0.2

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_move_idle"]
xfade_time = 0.25

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_idle_slash"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_move_slash"]
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_slash_idle"]
xfade_time = 0.2

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_slash_move"]
xfade_time = 0.2

[sub_resource type="AnimationNodeStateMachine" id="sm_player"]
states/Idle/node = SubResource("an_idle")
states/Idle/position = Vector2(441, 275)
states/Move/node = SubResource("bs_move")
states/Move/position = Vector2(574, 119)
states/Slash/node = SubResource("an_slash")
states/Slash/position = Vector2(623, 296)
states/Start/position = Vector2(135, 88)
transitions = ["Idle", "Move", SubResource("tr_idle_move"), "Move", "Idle", SubResource("tr_move_idle"), "Idle", "Slash", SubResource("tr_idle_slash"), "Move", "Slash", SubResource("tr_move_slash"), "Slash", "Idle", SubResource("tr_slash_idle"), "Slash", "Move", SubResource("tr_slash_move")]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_hurt"]
height = 1.3281

; PLAYER 3 — the Quaternius mannequin, sword only.
;
; Deliberately NOT a variant of player2.tscn: it carries a different animation library on a
; different rig, and half of player2's tree (the five-point Aim blend, the shield's Block) has no
; clip to stand on here. What it shares is the SCRIPT — everything below is the same player.gd,
; configured by export rather than forked. No shield, no bow, so those nodes are simply absent and
; player.gd's get_node_or_null paths find nothing; the Block and Shoot STATES are likewise missing
; from the StateMachine, and transition_to() no-ops when Idle/Move offer them.
;
; The 180 deg yaw on Model is the same correction paler2 needs: both rigs come out of the humanoid
; rest-fixer facing the same way, which is not Godot's forward. The -0.836 drops the feet to the
; bottom of the capsule.
[node name="Player" type="CharacterBody3D" groups=["player"]]
script = ExtResource("1_player")
face_movement = true
; UAL's locomotion is EMPTY-HANDED — the fists pump and the wrist rolls, because nothing was meant
; to be in them. Measured, a blade obeying that wrist swung 108 deg away from a carried angle
; inside one idle loop. 0.2 takes the carry angle from the torso and only a hint from the hand.
; player/player2 keep the default 1.0: their Mixamo clips WERE authored holding a sword.
hand_follow = 0.2
loop_clips = PackedStringArray("idle_sword", "block")
locomotion_clips = PackedStringArray("idle_sword", "walk", "jog", "sprint", "atk_a", "atk_b", "atk_c", "atk_dash", "chop", "atk_jab", "atk_swing", "atk_hook")
attack_timing = {
"atk_a": {"cancel": 0.7, "speed": 0.9, "strike": 0.45, "tail": 0.9, "windup": 0.16},
"atk_b": {"cancel": 0.68, "speed": 0.9, "strike": 0.45, "tail": 0.85, "windup": 0.18},
"atk_c": {"cancel": 0.62, "cancel_min": 0.68, "speed": 1.8, "strike": 0.4, "tail": 0.8, "windup": 0.26},
"atk_dash": {"cancel": 0.6, "speed": 1.7, "strike": 0.34, "tail": 0.9, "windup": 0.18},
"atk_hook": {"cancel": 0.68, "speed": 1.1, "strike": 0.45, "tail": 0.88, "windup": 0.16},
"atk_jab": {"cancel": 0.62, "speed": 1.3, "strike": 0.4, "tail": 0.9, "windup": 0.12},
"atk_swing": {"cancel": 0.68, "speed": 1.1, "strike": 0.45, "tail": 0.88, "windup": 0.16},
"chop": {"cancel": 0.7, "speed": 1.0, "strike": 0.45, "tail": 0.85, "windup": 0.22}
}

