[gd_scene load_steps=7 format=3]

; A rock in flight. Reuses projectile.gd wholesale -- it already does ballistic arcs, team sorting
; by collision mask, and damage through HurtBox.apply_hit(), which is exactly what a thrown boulder
; needs and none of which is worth writing twice. `speed` is low so the arc is a LOB: a four-metre
; ogre heaving a rock should be dodgeable by watching where it is going to land.
[ext_resource type="Script" path="res://scripts/projectile.gd" id="1_proj"]
[ext_resource type="PackedScene" path="res://scenes/fx/hit_spark.tscn" id="2_spark"]
[ext_resource type="Script" path="res://scripts/components/blade_trail.gd" id="3_trail"]

